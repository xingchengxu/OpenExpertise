{
  "name": "@openexpertise/node-kinds-agent",
  "version": "0.1.1",
  "description": "Dispatcher for `agent` nodes — calls an LLM with structured-output schema, writes validated keys to state.",
  "keywords": [
    "openexpertise",
    "workflow",
    "dag",
    "llm",
    "yaml",
    "agent",
    "dispatcher",
    "structured-output"
  ],
  "author": "OpenExpertise contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xingchengxu/OpenExpertise.git",
    "directory": "packages/node-kinds-agent"
  },
  "bugs": {
    "url": "https://github.com/xingchengxu/OpenExpertise/issues"
  },
  "homepage": "https://github.com/xingchengxu/OpenExpertise#readme",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@openexpertise/core": "workspace:*",
    "@openexpertise/schema": "workspace:*",
    "@anthropic-ai/sdk": "^0.30.0",
    "ajv": "^8.17.0"
  }
}
