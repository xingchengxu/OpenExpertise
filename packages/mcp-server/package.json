{
  "name": "@openexpertise/mcp-server",
  "version": "0.1.0",
  "description": "`oe-mcp` MCP server — exposes 6 OpenExpertise tools so external MCP-aware agents can run experiences.",
  "keywords": [
    "openexpertise",
    "workflow",
    "dag",
    "llm",
    "yaml",
    "mcp",
    "model-context-protocol",
    "agent"
  ],
  "author": "OpenExpertise contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xingchengxu/OpenExpertise.git",
    "directory": "packages/mcp-server"
  },
  "bugs": {
    "url": "https://github.com/xingchengxu/OpenExpertise/issues"
  },
  "homepage": "https://github.com/xingchengxu/OpenExpertise#readme",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
