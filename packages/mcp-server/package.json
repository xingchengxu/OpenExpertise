    "@openexpertise/node-kinds-skill": "workspace:*",
    "@openexpertise/node-kinds-tool": "workspace:*",
    "@openexpertise/schema": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.0.0"
  }
