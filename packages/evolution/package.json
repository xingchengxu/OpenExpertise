{
  "name": "@openexpertise/evolution",
  "version": "0.1.2",
  "description": "Advisor that reads a run's events+state and proposes graph upgrades as git-apply-ready diffs.",
  "keywords": [
    "openexpertise",
    "workflow",
    "dag",
    "llm",
    "yaml",
    "evolution",
    "optimization",
    "advisor"
  ],
  "author": "OpenExpertise contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xingchengxu/OpenExpertise.git",
    "directory": "packages/evolution"
  },
  "bugs": {
    "url": "https://github.com/xingchengxu/OpenExpertise/issues"
  },
  "homepage": "https://github.com/xingchengxu/OpenExpertise#readme",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "src/prompts",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b && node -e \"require('node:fs').cpSync('src/prompts','dist/prompts',{recursive:true})\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@openexpertise/core": "workspace:*",
    "@openexpertise/schema": "workspace:*"
  }
}
