{
  "name": "@openexpertise/cli",
  "version": "0.1.1",
  "description": "The `oe` command-line interface — run, resume, inspect, evolve, validate experiences.",
  "keywords": [
    "openexpertise",
    "workflow",
    "dag",
    "llm",
    "yaml",
    "cli",
    "oe"
  ],
  "author": "OpenExpertise contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xingchengxu/OpenExpertise.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/xingchengxu/OpenExpertise/issues"
  },
  "homepage": "https://github.com/xingchengxu/OpenExpertise#readme",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./llm-factory": {
      "import": "./dist/llm-factory.js",
      "types": "./dist/llm-factory.d.ts"
    }
  },
  "bin": {
    "oe": "./dist/bin.js"
  },
  "files": [
    "dist",
    "README.md",
    "registry.json",
    "demos",
    "templates"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "test": "vitest"
  },
  "dependencies": {
    "@openexpertise/core": "workspace:*",
    "@openexpertise/schema": "workspace:*",
    "@openexpertise/node-kinds-cli-agent": "workspace:*",
    "@openexpertise/node-kinds-tool": "workspace:*",
    "@openexpertise/node-kinds-agent": "workspace:*",
    "@openexpertise/node-kinds-skill": "workspace:*",
    "@openexpertise/node-kinds-dataset": "workspace:*",
    "@openexpertise/node-kinds-experience": "workspace:*",
    "@openexpertise/tui": "workspace:*",
    "@openexpertise/evolution": "workspace:*",
    "@openexpertise/authoring": "workspace:*",
    "@openexpertise/llm-openai": "workspace:*",
    "commander": "^12.0.0",
    "pino": "^9.0.0",
    "pino-pretty": "^11.0.0"
  }
}
